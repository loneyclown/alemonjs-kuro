{
  "name": "alemonjs-kuro",
  "version": "0.0.17",
  "description": "mhy-mod",
  "author": "ningmengchongshui",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json"
  },
  "scripts": {
    "app": "node index.js",
    "dev": "npx lvy app.ts",
    "view": "npx lvy app.ts --jsxp",
    "test:security": "node --test tests/security.test.mjs",
    "test:help": "npm run build && node --test tests/help.test.mjs tests/markdown.test.mjs",
    "test:panel": "npm run build && node --test tests/panel.test.mjs",
    "test:stamina": "npm run build && node --test tests/stamina.test.mjs",
    "test:explore": "npm run build && node --test tests/explore.test.mjs",
    "test:calabash": "npm run build && node --test tests/calabash.test.mjs",
    "test:tower": "npm run build && node --test tests/tower.test.mjs",
    "test:period": "npm run build && node --test tests/period.test.mjs",
    "test:coin": "npm run build && node --test tests/coin.test.mjs",
    "test:sign": "npm run build && node --test tests/sign.test.mjs",
    "test:announce": "npm run build && node --test tests/announce.test.mjs",
    "test:expose": "npm run build && node --test tests/expose.test.mjs",
    "lint": "eslint src --ext .ts,.tsx,.js --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx,.js --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@alemonjs/db": "^0.0.14",
    "@types/qrcode": "^1.5.6",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.20",
    "jsxp": "^1.3.0",
    "md5": "^2.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5"
  },
  "peerDependencies": {
    "alemonjs": "^2.1.124"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "alemonjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/xiuxianjs/alemonjs-kuro/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiuxianjs/alemonjs-kuro.git"
  },
  "gitHead": "ba61a67a3834a5147d6c8c4772396a68ebf87c88"
}
